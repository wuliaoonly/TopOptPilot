{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TopOptPilot",
  "version": "6.2.2",
  "identifier": "cn.topoptpilot.research",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "TopOptPilot",
      "width": 1440,
      "height": 900,
      "minWidth": 920,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "fullscreen": false,
      "visible": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "快速实现与深度优化一体化拓扑优化工作台",
    "longDescription": "TopOptPilot 桌面工作台，集成受控 MATLAB 快速实现、Policy 驱动的深度优化与独立审阅。",
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
