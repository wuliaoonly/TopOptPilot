# TopOptPilot Environment Configuration
# Copy to .env and fill in your values

# OpenAI-compatible Pi RPC test model; put the key in Credential Manager
# DASHSCOPE_API_KEY is a legacy environment fallback; prefer Credential Manager.
QWEN_BASE_URL=https://api.ai-pixel.online/v1
QWEN_MODEL=deepseek-v4-flash
TOPPILOT_AGENT_FRAMEWORK=pi-rpc

# MATLAB Configuration
MATLAB_PATH=C:\Program Files\MATLAB\R2025b
MATLAB_LICENSE_FILE=

# CUDA MEX Configuration
CUDA_PATH=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.8

# Storage Paths
PAPER_STORAGE=./knowledge/storage/papers
METHOD_CARD_STORAGE=./knowledge/storage/method_cards
EXPERIMENT_OUTPUT=./experiments/output

# Demonstration Mode
DEMO_MODE=false
